# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-S
# --- Optional integrations (server only, never prefix with NEXT_PUBLIC_) ---
# Full sermon archive. Without it only the 15 newest videos load.
YOUTUBE_API_KEY=
# Pastor prayer requests land in a Google Sheet (see supabase/SETUP.md).
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=
# Automatic Instagram and Facebook posts in the social section.
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_TOKEN=

# Bible games (server only, NEVER prefix with NEXT_PUBLIC_). Supabase > Project Settings > API > service_role.
# Lets the server keep answer keys private and record scores itself.
SUPABASE_SERVICE_ROLE_KEY=
